# .env.example — copy to .env and fill in your values
# NEVER commit .env to git. This file is safe to commit (contains only placeholders).

# ── YouTube Data API v3 ────────────────────────────────────────────────────────
# Get a new, restricted key from Google Cloud Console.
# Restrict it to: YouTube Data API v3 only.
# NEVER put a real key in this file.
YOUTUBE_API_KEY=

# ── HDFS ──────────────────────────────────────────────────────────────────────
# Override the HDFS URI from config/settings.yaml if needed
HDFS_URI=hdfs://namenode:8020

# ── COMMENT HASHING SALT ──────────────────────────────────────────────────────
# Used to hash commenter IDs for loyalty analysis (Phase 6).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
COMMENT_HASH_SALT=

# ── SPARK (optional overrides) ────────────────────────────────────────────────
SPARK_MASTER=local[*]

# ── PIPELINE MODE ─────────────────────────────────────────────────────────────
# Set to "live" to enable real YouTube API calls. Default is "dry_run".
YT_MODE=dry_run
