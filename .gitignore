# YouTube Influencer Detection Project — .gitignore

# ── SECRETS (NEVER commit these) ──────────────────────────────────────────────
.env
*.env.local

# ── DATA (large files; use YouNiverse download steps in README) ───────────────
data/
*.gz
*.csv.gz
*.jsonl.gz

# ── MODELS (stored in HDFS; too large for git) ────────────────────────────────
models/
*.model/

# ── LOGS AND STATE (ephemeral) ────────────────────────────────────────────────
logs/
state/
*.log
*.jsonl

# ── PYTHON ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ── VIRTUAL ENVIRONMENTS ──────────────────────────────────────────────────────
venv/
env/
.venv/
.env/

# ── SPARK ─────────────────────────────────────────────────────────────────────
derby.log
metastore_db/
spark-warehouse/

# ── JUPYTER ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── EDITORS ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── METRICS RUNS (keep registry and latest, not individual run dirs) ──────────
metrics/runs/

# ── IMAGES (auto-generated by pipeline) ──────────────────────────────────────
metrics/**/*.png

# ── FRONTEND & NODE ───────────────────────────────────────────────────────────
node_modules/
*/node_modules/
frontend/dist/
frontend/node_modules/

